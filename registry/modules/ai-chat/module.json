{
  "name": "ai-chat",
  "type": "module",
  "category": "ai",
  "title": "AI Chat",
  "description": "AI SDK chat route, model selector, message persistence, and prompt input.",
  "dependencies": [
    "ai@7.0.69",
    "@ai-sdk/react@4.0.72",
    "@ai-sdk/gateway@4.0.55",
    "lucide-react"
  ],
  "devDependencies": [],
  "registryDependencies": [
    "ai-sdk"
  ],
  "env": [
    "AI_GATEWAY_API_KEY",
    "AI_GATEWAY_BASE_URL",
    "AI_GATEWAY_MODEL"
  ],
  "files": [
    {
      "path": "apps/web/src/app/api/ai/chat/route.ts",
      "type": "registry:file"
    },
    {
      "path": "apps/web/src/components/ai/chat-box.tsx",
      "type": "registry:component"
    },
    {
      "path": "apps/web/src/lib/ai/prompts.ts",
      "type": "registry:file"
    },
    {
      "path": "apps/web/src/lib/ai/models.ts",
      "type": "registry:file"
    }
  ],
  "status": "ready",
  "maintenance": {
    "skills": [
      "ai-chat",
      "ai-sdk",
      "nextjs"
    ],
    "rules": [
      "keep-model-routing-server-side",
      "validate-public-input",
      "track-cost-sensitive-calls"
    ]
  }
}
