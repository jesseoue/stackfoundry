{
  "name": "developer-portal",
  "type": "module",
  "category": "developer-platform",
  "title": "Developer Portal",
  "description": "Developer dashboard shell for keys, docs, webhooks, and usage.",
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": [
    "api-keys"
  ],
  "env": [],
  "files": [
    {
      "path": "apps/web/src/lib/developer-portal.ts",
      "type": "registry:file"
    },
    {
      "path": "apps/web/src/app/(console)/developers/page.tsx",
      "type": "registry:page"
    }
  ],
  "status": "ready",
  "maintenance": {
    "skills": [
      "developer-portal",
      "nextjs",
      "docs-hosting"
    ],
    "rules": [
      "validate-public-input",
      "version-public-contracts",
      "never-leak-provider-errors"
    ]
  }
}
