{
  "name": "api-usage-dashboard",
  "type": "module",
  "category": "developer-platform",
  "title": "API Usage Dashboard",
  "description": "Per-key usage cards, request totals, errors, and limit visibility.",
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": [
    "api-keys",
    "usage-metering"
  ],
  "env": [],
  "files": [
    {
      "path": "apps/web/src/lib/api-usage-dashboard.ts",
      "type": "registry:file"
    },
    {
      "path": "apps/web/src/app/(console)/developers/usage/page.tsx",
      "type": "registry:page"
    }
  ],
  "status": "ready",
  "maintenance": {
    "skills": [
      "api-usage-dashboard",
      "nextjs"
    ],
    "rules": [
      "validate-public-input",
      "version-public-contracts",
      "never-leak-provider-errors"
    ]
  }
}
