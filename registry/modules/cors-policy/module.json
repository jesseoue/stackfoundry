{
  "name": "cors-policy",
  "type": "module",
  "category": "security",
  "title": "CORS Policy",
  "description": "Allowed origin configuration, preflight helpers, and deployment checklist.",
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": [],
  "env": [],
  "files": [
    {
      "path": "apps/web/src/lib/cors-policy.ts",
      "type": "registry:file"
    },
    {
      "path": "apps/web/src/app/(console)/admin/security/cors/page.tsx",
      "type": "registry:page"
    }
  ],
  "status": "ready",
  "maintenance": {
    "skills": [
      "cors-policy",
      "nextjs"
    ],
    "rules": [
      "fail-closed",
      "audit-sensitive-actions",
      "never-log-secrets",
      "audit-routing-changes"
    ]
  }
}
