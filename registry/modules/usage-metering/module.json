{
  "name": "usage-metering",
  "type": "module",
  "category": "billing",
  "title": "Usage Metering",
  "description": "Usage event capture, aggregation helpers, and billing-ready usage UI.",
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": [
    "drizzle-postgres"
  ],
  "env": [],
  "files": [
    {
      "path": "packages/db/src/schema/usage-metering.ts",
      "type": "registry:file"
    },
    {
      "path": "apps/web/src/lib/usage-metering.ts",
      "type": "registry:lib"
    },
    {
      "path": "apps/web/src/app/(console)/usage/page.tsx",
      "type": "registry:page"
    }
  ],
  "drizzle": {
    "schemaExports": [
      "usageMetering"
    ],
    "migrationRecommended": true
  },
  "status": "ready",
  "maintenance": {
    "skills": [
      "usage-metering",
      "nextjs",
      "drizzle"
    ],
    "rules": [
      "server-authorize-plan-state",
      "idempotent-money-mutations",
      "audit-billing-changes"
    ]
  }
}
