{
  "name": "security-activity",
  "type": "module",
  "category": "components",
  "title": "Security Activity",
  "description": "Security event timeline with severity, actor, and timestamp display.",
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": [],
  "env": [],
  "files": [
    {
      "path": "apps/web/src/lib/stackfoundry/security-activity.ts",
