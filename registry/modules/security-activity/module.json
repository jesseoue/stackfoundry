    },
    {
      "path": "apps/web/src/app/(console)/components/security-activity/page.tsx",
      "type": "registry:page"
    }
  ],
  "status": "ready",
  "maintenance": {
    "skills": [
      "security-activity",
      "nextjs"
    ],
    "rules": [
      "tenant-scoped-events",
      "redact-sensitive-details",
      "immutable-audit-source"
    ]
  }
