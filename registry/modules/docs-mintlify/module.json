{
  "name": "docs-mintlify",
  "type": "module",
  "category": "docs",
  "title": "Mintlify Docs",
  "description": "Hosted documentation workspace starter with Mintlify configuration, pages, and deployment guidance.",
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": [
    "seo"
  ],
  "env": [],
  "files": [
    {
      "path": "docs/mintlify/docs.json",
      "type": "registry:file"
    },
    {
      "path": "docs/mintlify/introduction.mdx",
      "type": "registry:file"
    },
    {
      "path": "docs/mintlify/quickstart.mdx",
      "type": "registry:file"
    },
    {
      "path": "docs/mintlify/deployment.md",
      "type": "registry:file"
    }
  ],
  "status": "ready",
  "maintenance": {
    "skills": [
      "docs-mintlify",
      "mintlify",
      "docs-hosting"
    ],
    "rules": [
      "keep-public-docs-source-owned",
      "avoid-private-data-leaks",
      "verify-install-path"
    ]
  }
}
