{
  "name": "workspace-switcher",
  "type": "module",
  "category": "components",
  "title": "Workspace Switcher",
  "description": "Accessible workspace selector with tenant-safe switch behavior.",
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": [],
  "env": [],
  "files": [
    {
      "path": "apps/web/src/lib/stackfoundry/workspace-switcher.ts",
      "type": "registry:file"
    },
    {
      "path": "apps/web/src/components/stackfoundry/workspace-switcher.tsx",
      "type": "registry:component"
    },
    {
      "path": "apps/web/src/app/(console)/components/workspace-switcher/page.tsx",
      "type": "registry:page"
    }
  ],
  "status": "ready",
  "maintenance": {
    "skills": [
      "workspace-switcher",
      "nextjs"
    ],
    "rules": [
      "server-scoped-workspaces",
      "audit-sensitive-switches",
      "fail-closed-access"
    ]
  }
}
