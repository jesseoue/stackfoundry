{
  "name": "integration-card",
  "type": "module",
  "category": "components",
  "title": "Integration Card",
  "description": "Connection card for marketplace integrations with status and sync metadata.",
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": [],
  "env": [],
  "files": [
    {
      "path": "apps/web/src/lib/stackfoundry/integration-card.ts",
      "type": "registry:file"
    },
    {
      "path": "apps/web/src/components/stackfoundry/integration-card.tsx",
      "type": "registry:component"
    },
    {
      "path": "apps/web/src/app/(console)/components/integration-card/page.tsx",
      "type": "registry:page"
    }
  ],
  "status": "ready",
  "maintenance": {
    "skills": [
      "integration-card",
      "nextjs"
    ],
    "rules": [
      "server-side-credentials",
      "workspace-scoped-connections",
      "secrets-manager-only"
    ]
  }
}
