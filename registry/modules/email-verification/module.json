{
  "name": "email-verification",
  "type": "module",
  "category": "auth",
  "title": "Email Verification",
  "description": "Email verification token helpers and verification state UI.",
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": [
    "drizzle-postgres"
  ],
  "env": [],
  "files": [
    {
      "path": "packages/db/src/schema/email-verification.ts",
      "type": "registry:file"
    },
    {
      "path": "apps/web/src/lib/email-verification.ts",
      "type": "registry:file"
    },
    {
      "path": "apps/web/src/app/(auth)/email-verification/page.tsx",
      "type": "registry:page"
    }
  ],
  "drizzle": {
    "schemaExports": [
      "emailVerification"
    ],
    "migrationRecommended": true
  },
  "status": "ready",
  "maintenance": {
    "skills": [
      "email-verification",
      "nextjs",
      "drizzle"
    ],
    "rules": [
      "tenant-scope-every-query",
      "authorize-before-render",
      "audit-sensitive-actions",
      "expire-tokens-single-use"
    ]
  }
}
